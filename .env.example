# ==============================================================================
# AWS BUILDER HUB - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local and populate with credentials from your Supabase Dashboard
# Settings -> API (Project URL & API Keys)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC SUPABASE CREDENTIALS (Safe for browser / client-side)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Public / Anon API Key (Client-safe with Row Level Security)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (NEVER EXPOSE TO BROWSER / CLIENT-SIDE)
# ------------------------------------------------------------------------------
# WARNING: The Service Role key bypasses all Row Level Security (RLS).
# ONLY use this in backend administrative scripts, migrations, or server routes.
# NEVER prefix with NEXT_PUBLIC_ or VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
